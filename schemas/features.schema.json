{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "feature_set_id",
    "path",
    "sha256",
    "reference_id",
    "resolution",
    "coordinate_convention",
    "source",
    "discovery_samples",
    "independent_of_analysis_samples"
  ],
  "properties": {
    "independent_of_analysis_samples": {
      "type": "boolean"
    },
    "discovery_samples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coordinate_convention": {
      "const": "0-based-half-open"
    }
  },
  "additionalProperties": true
}
