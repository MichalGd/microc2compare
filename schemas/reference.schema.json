{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "reference_id",
    "chromsizes",
    "chromsizes_sha256",
    "views",
    "views_sha256"
  ],
  "properties": {
    "reference_id": {
      "type": "string"
    },
    "chromsizes": {
      "type": "string"
    },
    "chromsizes_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "views": {
      "type": "string"
    },
    "views_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "chromosome_classes": {
      "type": "object",
      "properties": {
        "autosomes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "sex": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "mitochondrial": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "other": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
